# E-mail da recuperação de senha (US-02). Copie para .env (na raiz) e preencha. O .env não vai pro git.
# Senha de app do Gmail: ative a verificação em 2 etapas na conta Google, abra
# https://myaccount.google.com/apppasswords, crie uma senha de app "NeoFluxo" e cole os 16 caracteres (sem espaços) em MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente (opcional): vazio = MAIL_USERNAME
MAIL_FROM=
# Endereço do front usado no link do e-mail
APP_FRONTEND_URL=http://localhost:5173
